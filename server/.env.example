PORT=8787
CLIENT_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Creditcoin CC3 testnet RPC the operator wallet signs transactions against.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Operator/treasury wallet that pays out new-signup drips (and collects Heal All /
# Continue-after-breach fees). NEVER commit this key. Testnet funds only.
OPERATOR_PRIVATE_KEY=your-operator-wallet-private-key
DRIP_AMOUNT_CTC=1
OPERATOR_MIN_BALANCE_CTC=2
